@@ -0,0 +1,15 @@
+import Foundation
+
+/// A continuous round trip, with a stationary pause at each end.
+struct TitleMarqueeMotion {
+    static func offset(elapsed: TimeInterval, overflow: CGFloat, speed: CGFloat = 24, pause: TimeInterval = 2) -> CGFloat {
+        guard overflow > 0, speed > 0 else { return 0 }
+        let travel = TimeInterval(overflow / speed)
+        let cycle = 2 * pause + 2 * travel
+        let phase = max(0, elapsed).truncatingRemainder(dividingBy: cycle)
+        if phase < pause { return 0 }
+        if phase < pause + travel { return min(overflow, CGFloat(phase - pause) * speed) }
+        if phase < 2 * pause + travel { return overflow }
+        return max(0, overflow - CGFloat(phase - 2 * pause - travel) * speed)
+    }
+}
